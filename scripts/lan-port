#!/usr/bin/bash
# Open one firewall port for a local Quick Bridge session, then remove it
# when the session closes the hold fifo. This script runs as the user.
# sudo is only ever /usr/bin/sudo -- /usr/bin/ufw with checked arguments.
set -euo pipefail
umask 077

HERE="$(/usr/bin/dirname -- "${BASH_SOURCE[0]}")"
# shellcheck disable=SC1091
. "$HERE/messages.sh"

iface=${1:-}
port=${2:-}
dir=${3:-}

fail() {
  printf '%s\n' "$(qb_msg lan_allow_failed)" >&2
  exit 1
}

[[ $iface =~ ^[A-Za-z0-9._-]{1,15}$ ]] || fail
[[ $iface != lo && $iface != .* && $iface != -* ]] || fail
[[ -d /sys/class/net/$iface ]] || fail

[[ $port =~ ^[0-9]{1,5}$ ]] || fail
port_num=$((10#$port))
[[ $port_num -ge 1024 && $port_num -le 65535 ]] || fail
port=$port_num

: "${XDG_RUNTIME_DIR:?}"
case $dir in
  "$XDG_RUNTIME_DIR"/quickbridge-lan.*) ;;
  *) fail ;;
esac
[[ $dir != *..* && $dir != *$'\n'* ]] || fail
[[ -d $dir && ! -L $dir ]] || fail
owner=$(/usr/bin/stat -c %u -- "$dir") || fail
mode=$(/usr/bin/stat -c %a -- "$dir") || fail
[[ $owner == "$(/usr/bin/id -u)" && $mode == 700 ]] || fail
[[ -p $dir/hold && ! -L $dir/hold && -p $dir/life && ! -L $dir/life ]] || fail

ALLOWED=0
rule=(
  allow in on "$iface" to any port "$port" proto tcp
  comment "quickbridge-$port"
)

cleanup() {
  [[ $ALLOWED == 1 ]] || return 0
  ALLOWED=0
  if ! /usr/bin/sudo -n -- /usr/bin/ufw delete "${rule[@]}"; then
    if ! /usr/bin/sudo -- /usr/bin/ufw delete "${rule[@]}"; then
      printf '%s\n' "$(qb_msg lan_stuck)"
      printf 'sudo ufw delete allow in on %s to any port %s proto tcp\n' "$iface" "$port"
      return 0
    fi
  fi
  printf '%s\n' "$(qb_msg lan_closed)"
}

trap cleanup EXIT

printf '%s\n' "$(qb_msg lan_intro "$iface" "$port")"
/usr/bin/sudo -- /usr/bin/ufw "${rule[@]}" || fail
ALLOWED=1

# Held until this process exits so the session can see the window die.
exec 3>"$dir/life"
tmp=$(/usr/bin/mktemp -p "$dir" .open.XXXXXXXXXX)
/usr/bin/mv -f -T -- "$tmp" "$dir/open"
printf '%s\n' "$(qb_msg lan_open "$port")"
/usr/bin/cat -- "$dir/hold" >/dev/null || true
exit 0
